    "tools": [
      {
        "name": "list_indices",
        "description": "List Algolia indices using a key with listIndexes permission.",
        "method": "GET",
        "path": "/indexes",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 0
            },
            "hitsPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {
            "page": "page",
            "hitsPerPage": "hitsPerPage"
          },
          "body": {}
        },
        "sampleArguments": {},
        "provenance": [
          "https://raw.githubusercontent.com/algolia/api-clients-automation/main/specs/bundled/search.yml"
        ]
      },
      {
        "name": "search_index",
        "description": "Search one index without modifying its records.",
        "method": "POST",
        "path": "/indexes/{indexName}/query",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "indexName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Identifier"
            },
            "query": {
              "type": "string",
              "maxLength": 512
            },
            "hitsPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "page": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "indexName"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [
            "indexName"
          ],
          "query": {},
          "body": {
            "query": "query",
            "hitsPerPage": "hitsPerPage",
            "page": "page"
          }
        },
        "sampleArguments": {
          "indexName": "products",
          "query": "blue",
          "hitsPerPage": 10
        },
        "provenance": [
          "https://raw.githubusercontent.com/algolia/api-clients-automation/main/specs/bundled/search.yml"
        ]
      }
    ],
